# 复制本文件为 .env 后填入自己的值（.env 已被 .gitignore 忽略，不会进版本库）。
#
# 不想手填？两种更省事的做法：
#   1) Windows 双击根目录 start.bat —— 首次运行会弹窗，选个服务商自动填地址/模型，你只粘 API Key；
#   2) 打开「管理台 → 模型配置」(http://localhost:8080/admin.html#model) —— 可视化编辑，保存立即生效、不用重启。
# 下面这份模板给"想自己掌控 / 非 Windows 平台"的用户用。
#
# 格式：KEY=value。以下写法都能识别：
#   KEY=value          KEY="value"          KEY='value'
#   export KEY=value   KEY=value  # 行尾注释
# 也可以用真正的系统环境变量覆盖同名项，优先级：系统环境变量 > .env > application.yml 默认值。
# .env 从工作目录向上最多 5 层查找，可用 -Ddotenv.location=/path/to/.env 显式指定。
#
# 全部留空也能启动：应用可正常运行、页面可打开，但 agent 不会发言
# （群聊页会显示"模型未配置"横幅），记忆召回退化为"最近若干条"。

# ---- 运行环境 ----
APP_DB_PATH=data/chat.db
# 公网暴露时建议设置，非空后所有 /api/** 需带 X-Access-Token 请求头（SSE 用 ?token=）
APP_ACCESS_TOKEN=

# ---- 向量维度：必须与所选 embedding 模型的输出维度一致 ----
# qwen3.7-text-embedding / text-embedding-v4 / bge-m3 = 1024
# text-embedding-3-small = 1536；智谱 embedding-3 = 2048；nomic-embed-text = 768
APP_VEC_DIMENSION=1024

# ---- 节假日 / 调休（可选，让 agent 知道"今天到底上不上班、是不是假期"）----
# 只按星期几判断会把国庆、春节和"调休上班的周六"全判错（agent 会在假期里说"上班加油"）。
# 默认开启，查一次缓存一天；断网 / 接口改了 / 超时 会自动降级成"周一~周五=工作日"，不影响使用。
# 不想让本机访问外部接口就设 APP_HOLIDAY_ENABLED=false。
APP_HOLIDAY_ENABLED=true
# 实际请求 {BASE_URL}/{yyyy-MM-dd}，返回 {isHoliday, isWorkday, holiday:{name,type}}
APP_HOLIDAY_BASE_URL=https://api.apisbo.com/holidays/date
APP_HOLIDAY_TIMEOUT_MS=2500
# 查询失败后的重试间隔（秒）：避免查询失败时每次拼 prompt 都去打接口
APP_HOLIDAY_RETRY_SECONDS=600

# ---- 主力发言模型（任意 OpenAI 兼容 /chat/completions 服务）【必填】----
# 决定 agent「说什么」。baseUrl 填到 /v1 为止，不要带 /chat/completions。
# 例：https://api.deepseek.com/v1 + deepseek-chat
#     https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
APP_MODEL_CHAT_BASE_URL=
APP_MODEL_CHAT_API_KEY=
APP_MODEL_CHAT_MODEL=
# 关闭"思考模式"（请求体带 enable_thinking=false）：
#   阿里云百炼 / MaaS 上的 qwen3.x、deepseek 等思考模式网关 → true（否则 tool_choice=required 会被拒 400）
#   DeepSeek 官方 / OpenAI / 硅基流动 / 智谱等不认这个非标准字段的网关 → false
APP_MODEL_CHAT_DISABLE_THINKING=true

# ---- 门控模型（flash 级小模型，判断"要不要接话"，调用量最大，用便宜的）----
# 三项留空则自动回退使用 chat 模型（贵一点，功能不变）
APP_MODEL_GATE_BASE_URL=
APP_MODEL_GATE_API_KEY=
APP_MODEL_GATE_MODEL=
APP_MODEL_GATE_DISABLE_THINKING=true

# ---- embedding 模型（向量模型）；留空则记忆召回退化为"最近若干条" ----
# 配了它就要把上面的 APP_VEC_DIMENSION 填对，否则记忆写入会失败
# 例：https://api.siliconflow.cn/v1 + BAAI/bge-m3
APP_MODEL_EMBEDDING_BASE_URL=
APP_MODEL_EMBEDDING_API_KEY=
APP_MODEL_EMBEDDING_MODEL=
APP_MODEL_EMBEDDING_DISABLE_THINKING=true

# ---- rerank 模型（重排）；留空则跳过 rerank，直接用向量分数排序 ----
# 注意：这里要填"完整端点"，各家格式不一样，例如
#   百炼：https://<实例>.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
#   硅基流动：https://api.siliconflow.cn/v1/rerank
#   智谱：https://open.bigmodel.cn/api/paas/v4/rerank
#   Cohere：https://api.cohere.com/v2/rerank
APP_MODEL_RERANK_BASE_URL=
APP_MODEL_RERANK_API_KEY=
APP_MODEL_RERANK_MODEL=
APP_MODEL_RERANK_DISABLE_THINKING=true